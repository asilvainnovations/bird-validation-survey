# Copy to .env for local dev, and set these in your host's dashboard
# (Bolt / Vercel / Netlify project settings) for deployed environments.

# ── Supabase ──────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Canonical domain ──────────────────────────────────────────────────────
# The single source of truth for this app's public URL. Used by:
#   - index.html          (<link rel="canonical">, og:url)          via %VITE_CANONICAL_DOMAIN%
#   - public/manifest.json (related_applications)                    via scripts/generate-manifest.mjs
# Set the SAME value as a Supabase secret (not VITE_-prefixed) named
# CANONICAL_DOMAIN so supabase/functions/email-notifications can use it too.
VITE_CANONICAL_DOMAIN=https://bird-validation-survey.bolt.host

# ── Optional ──────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=
