# ════════════════════════════════════════════════════════════════════════════
# BIRD 2026-2035 · Environment Variables
# Copy this file to .env and fill in your values.
# All variables prefixed with VITE_ are exposed to the client bundle.
# ════════════════════════════════════════════════════════════════════════════

# ─── Supabase Project (REQUIRED) ────────────────────────────────────────────
# Your Supabase project URL and anon key.
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://cacimkjpkxflrtgspiay.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Service Role Key (OPTIONAL — dev/admin only) ───────────────────────────
# WARNING: Never expose this in production client builds.
# Used only for local admin scripts or Edge Function development.
# VITE_SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── Sentry Error Tracking (OPTIONAL) ───────────────────────────────────────
# VITE_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# ─── Branding Asset Overrides (OPTIONAL) ────────────────────────────────────
# VITE_BRAND_LOGO_URL=https://your-cdn.com/logo.png
# VITE_AI_STRATEGIST_AVATAR_URL=https://your-cdn.com/avatar.png
# VITE_BANNER_INVESTMENT_URL=https://your-cdn.com/banner.png

# ─── External Platform URLs (OPTIONAL) ──────────────────────────────────────
# VITE_PWA_EXTERNAL_URL=https://your-domain.com
# VITE_USER_MANUAL_URL=https://your-manual.com
# VITE_DEVELOPER_DOCS_URL=https://your-docs.com
